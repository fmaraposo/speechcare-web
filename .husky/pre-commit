#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|tsx)$')

if [ -n "$FILES" ]; then
  echo "🔍 Running ESLint with config..."
  npx eslint --config eslint.config.mjs -- $FILES
  RESULT=$?
  if [ $RESULT -ne 0 ]; then
    echo "❌ ESLint failed. Commit aborted."
    exit 1
  fi
else
  echo "✅ No JS/TS files staged for commit."
fi


